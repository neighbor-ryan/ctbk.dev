// Assets plus public per-view OG metadata and browser screenshots.
//
// `not_found_handling: single-page-application` serves `index.html`
// (HTTP 200) for any path with no asset — replaces the GH Pages
// `404.html` hack. Per-station stubs (`dist/s/<slug>.html`) are
// ordinary assets and win over the fallback for crawler og meta.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctbk-dev",
  "main": "server/public-worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "ratelimits": [{ "name": "OG_RENDER_LIMIT", "namespace_id": "2026102001", "simple": { "limit": 10, "period": 60 } }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/v2", "/stations", "/s/*", "/timelapse", "/movie", "/health", "/health/feed", "/pipeline", "/og.jpg"]
  },
  // NOTE: the `ctbk.dev` custom domain is deliberately NOT declared here
  // (`routes` + `custom_domain`): it's attached once via the dashboard and
  // persists as account state. Declaring it would make every `wrangler
  // deploy` hit the workers-domains API, which the narrow-scope CI token
  // (Workers/R2/D1, no zone perms) can't touch.
  "dev": {
    // FE dev server is 3456; wrangler = +1 per convention.
    "port": 3457
  },
  "observability": {
    "enabled": true
  },
  // Staging site at dev.ctbk.dev (`wrangler deploy --env dev` → worker
  // `ctbk-dev-dev`; the `dev` branch deploys here via www.yml). Same
  // domain-attach convention as prod: `dev.ctbk.dev` is account state,
  // not config.
  "env": {
    "dev": {
      "browser": { "binding": "BROWSER" },
      "ratelimits": [{ "name": "OG_RENDER_LIMIT", "namespace_id": "2026102002", "simple": { "limit": 10, "period": 60 } }],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/", "/v2", "/stations", "/s/*", "/timelapse", "/movie", "/health", "/health/feed", "/pipeline", "/og.jpg"]
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
